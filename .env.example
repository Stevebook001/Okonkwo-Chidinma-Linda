# Supabase (create a dedicated OCL project; do not reuse an unrelated project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY= # Server-only secret key; never prefix with NEXT_PUBLIC_

# Resend transactional email
RESEND_API_KEY=
RESEND_FROM_EMAIL=OCL Health <no-reply@ocl.it.com>
OCL_SUPPORT_EMAIL=me.ocl.it.com@gmail.com

# Admin Basic Auth — set strong unique values in Vercel Production Environment Variables
OCL_ADMIN_USER=
OCL_ADMIN_PASSWORD=

# Optional future payment integrations
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
